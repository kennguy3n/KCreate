{
  "name": "@kcreate/kchat-extension",
  "version": "0.0.1",
  "private": true,
  "description": "KCreate companion extension for KChat Desktop (signed .kcz bundle, sidebar panel for recent projects and share-invite cards)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sign": "node scripts/sign.mjs",
    "package": "node scripts/build.mjs && node scripts/sign.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 src tests scripts",
    "test": "node --test tests/manifest.test.mjs tests/invite-card.test.mjs tests/store.test.mjs tests/sign.test.mjs tests/phase9-panels.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "esbuild": "0.24.0",
    "eslint": "9.16.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3"
  }
}
