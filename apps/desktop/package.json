{
  "name": "@kcreate/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "KCreate desktop shell (Electron main + preload + renderer)",
  "author": "KCreate contributors <maintainers@kcreate.io>",
  "homepage": "https://github.com/kennguy3n/KCreate",
  "license": "AGPL-3.0-or-later",
  "main": "main/dist/main.js",
  "scripts": {
    "build": "node build.mjs && vite build --config renderer/vite.config.ts",
    "typecheck": "tsc -b tsconfig.main.json tsconfig.preload.json --noEmit && tsc -p renderer/tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint --max-warnings=0 main preload renderer",
    "test": "node --test renderer/tests/templates.test.mjs renderer/tests/rightPanelTabs.test.mjs renderer/tests/i18nFormat.test.mjs && vitest run --config renderer/vitest.config.ts",
    "test:vitest": "vitest run --config renderer/vitest.config.ts",
    "test:vitest:watch": "vitest --config renderer/vitest.config.ts",
    "test:e2e": "node --test tests/e2e/boot.test.mjs",
    "start": "electron .",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "stage:bridge": "node scripts/stage-bridge.mjs",
    "prepackage": "pnpm build && pnpm stage:bridge",
    "package": "pnpm prepackage && electron-builder --config electron-builder.yml",
    "package:linux": "pnpm prepackage && electron-builder --config electron-builder.yml --linux",
    "package:mac": "pnpm prepackage && electron-builder --config electron-builder.yml --mac",
    "package:win": "pnpm prepackage && electron-builder --config electron-builder.yml --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "0.24.0",
    "eslint": "9.16.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.60.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.8"
  }
}
